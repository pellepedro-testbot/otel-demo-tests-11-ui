{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "esnext"],
    "types": ["cypress", "node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true
  },
  "include": ["cypress.config.ts", "cypress/**/*.ts"]
}
